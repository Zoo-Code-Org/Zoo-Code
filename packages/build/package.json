{
	"name": "@roo-code/build",
	"description": "ESBuild utilities for Roo Code.",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"build": "tsc",
		"clean": "rimraf dist .turbo"
	},
	"devDependencies": {
		"@roo-code/config-eslint": "workspace:^",
		"@roo-code/config-typescript": "workspace:^",
		"@types/node": "22.20.1",
		"vitest": "4.1.9"
	}
}
