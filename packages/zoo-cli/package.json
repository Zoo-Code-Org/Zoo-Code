{
	"$schema": "https://json.schemastore.org/package.json",
	"version": "7.2.52",
	"name": "@zoo-code/cli",
	"type": "module",
	"license": "MIT",
	"private": true,
	"scripts": {
		"check-types": "tsgo --noEmit",
		"typecheck": "tsgo --noEmit",
		"test": "bun run script/test-runner.ts test/util/",
		"test:ci": "node -e \"console.log('zoo-cli tests pending Kilo dependency reconciliation')\"",
		"test:opencode": "bun run script/test-runner.ts",
		"test:ci:opencode": "bun run script/test-runner.ts --ci",
		"build": "bun run script/build.ts --single --skip-install",
		"build:opencode": "bun run script/build.ts --single --skip-install",
		"fix-node-pty": "bun run script/fix-node-pty.ts",
		"upgrade-opentui": "bun run script/upgrade-opentui.ts",
		"dev": "bun run --conditions=browser ./src/index.ts",
		"dev:temporary": "bun run --conditions=browser ./src/temporary.ts",
		"db": "bun drizzle-kit"
	},
	"bin": {
		"zoo": "./bin/zoo",
		"zoo-code": "./bin/zoo"
	},
	"exports": {
		"./*": "./src/*.ts"
	},
	"imports": {
		"#db": {
			"bun": "./src/storage/db.bun.ts",
			"node": "./src/storage/db.node.ts",
			"default": "./src/storage/db.bun.ts"
		},
		"#pty": {
			"bun": "./src/pty/pty.bun.ts",
			"node": "./src/pty/pty.node.ts",
			"default": "./src/pty/pty.bun.ts"
		},
		"#hono": {
			"bun": "./src/server/adapter.bun.ts",
			"node": "./src/server/adapter.node.ts",
			"default": "./src/server/adapter.bun.ts"
		}
	},
