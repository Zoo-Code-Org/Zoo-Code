{
	"extends": "./packages/config-typescript/base.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "Bundler",
		"baseUrl": ".",
		"paths": {
			"@roo-code/*": ["packages/*/src", "packages/*"]
		},
		// Scripts import src code. Match the src package settings so the root check does not report src errors.
		"noUncheckedIndexedAccess": false,
		"useUnknownInCatchVariables": false
	},
	"exclude": ["node_modules"],
	"include": ["scripts/*.ts", "src/types/*.d.ts"]
}
