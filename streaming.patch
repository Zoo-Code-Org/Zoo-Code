+		mode: "code",
+		usage: {
+			inputTokens: { value: 1000, source: "provider" },
+			outputTokens: { value: 500, source: "provider" },
+			costUsd: { value: 0.01, source: "provider" },
+		},
+		semantics: {
+			cacheReadInInput: "excluded",
+			cacheWriteInInput: "excluded",
+			reasoningInOutput: "excluded",
+		},
+		provenance: "live",
+		...overrides,
+	}
