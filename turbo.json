{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"lint": {},
		"check-types": {
			"dependsOn": ["@roo-code/types#build"]
		},
		"test": {
			"dependsOn": ["@roo-code/types#build"]
		},
		"test:coverage": {
			"dependsOn": ["@roo-code/types#build"],
			"outputs": ["coverage/**"]
		},
		"format": {},
		"clean": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"inputs": ["$TURBO_DEFAULT$"]
		},
		"watch:tsc": {
			"cache": false
		}
	}
}
