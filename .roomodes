customModes:
  - slug: example-mode
    name: 🗒️ Example Mode
    roleDefinition: >-
      You are a specialist focused on [describe the role here]. Your expertise
      includes [list capabilities or responsibilities].
    whenToUse: >-
      Use this mode when [describe the situation or trigger that calls for this
      mode]. It is best suited for [describe the kind of task].
    description: A short description shown in the mode picker.
    groups:
      - read
      - edit
      - command
      - mcp
    source: project
