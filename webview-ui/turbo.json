{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"outputs": ["../src/webview-ui/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/src/shared/**",
				"$TURBO_ROOT$/src/core/**",
				"$TURBO_ROOT$/src/services/**",
				"$TURBO_ROOT$/src/package.json"
			],
			"env": ["PKG_RELEASE_CHANNEL", "VSCODE_TEXTMATE_DEBUG"]
		},
		"check-types": {
			"dependsOn": ["@roo-code/types#build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/src/shared/**",
				"$TURBO_ROOT$/src/core/**",
				"$TURBO_ROOT$/src/services/**",
				"$TURBO_ROOT$/src/package.json"
			]
		}
	}
}
