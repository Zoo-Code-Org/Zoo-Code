{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignore": [
		"apps/vscode-e2e/**",
		"scripts/**",
		"apps/cli/scripts/**",
		"**/__tests__/**!",
		"packages/core/src/custom-tools/__tests__/fixtures/**",
		"packages/core/src/custom-tools/__tests__/fixtures-override/**",
		"src/integrations/misc/__tests__/performance/**",
		"src/integrations/terminal/__tests__/setupTerminalTests.ts",
		"src/integrations/terminal/__tests__/streamUtils/index.ts",
		"src/services/tree-sitter/__tests__/fixtures/sample-python.ts",
		"src/services/tree-sitter/__tests__/helpers.ts"
	],
	"ignoreDependencies": ["lint-staged"],
	"ignoreExportsUsedInFile": true,
	"playwright": false,
	"playwright-ct": false,
	"workspaces": {
		"src": {
			"entry": ["extension.ts!", "extension/api.ts!", "workers/countTokens.ts!"],
			"project": [
				"**/*.ts!",
				"!**/__tests__/**!",
				"!vitest.setup.ts!",
				"!utils/vitest-verbosity.ts!",
				"!utils/TaskSemaphore.ts!",
				"!utils/WorkspacePathResolver.ts!"
			],
			"ignoreDependencies": [
				"@roo-code/config-typescript",
				"@types/node-cache",
				"@types/vscode",
				"@vscode/ripgrep",
				"esbuild-wasm",
				"tree-sitter-wasms",
				"vscode-material-icons"
			]
		},
		"webview-ui": {
			"entry": ["src/index.tsx!"],
			"project": [
				"src/**/*.{ts,tsx}!",
				"../src/shared/*.ts!",
				"!src/utils/test-utils.tsx!",
				"!src/vite-plugins/**!"
			],
			"ignoreDependencies": [
				"@roo-code/config-typescript",
				"@types/katex",
				"@types/stacktrace-js",
				"babel-plugin-react-compiler",
				"katex",
				"react-compiler-runtime",
				"source-map",
				"tailwindcss",
				"tailwindcss-animate",
				"monocart-reporter"
			]
		},
		"apps/cli": {
			"ignore": ["eslint.config.mjs", "scripts/**"],
			"project": ["src/**/*.ts!", "src/**/*.tsx!"],
			"ignoreDependencies": ["@vscode/ripgrep"]
		},
		"apps/vscode-nightly": {
			"ignore": ["esbuild.mjs"]
		},
		"packages/config-typescript": {
			"ignoreUnresolved": ["vitest/globals"]
		},
		"packages/types": {
			"project": ["src/**/*.ts!", "!src/roomodes-schema.ts!"]
		},
		"packages/core": {
			"project": ["src/**/*.ts!"],
			"ignoreDependencies": ["esbuild"]
		},
		"packages/vscode-shim": {
			"project": ["src/**/*.ts!"]
		},
		"packages/cloud": {
			"project": ["src/**/*.ts!"],
			"ignoreDependencies": ["@types/vscode"]
		},
		"packages/telemetry": {
			"project": ["src/**/*.ts!"],
			"ignoreDependencies": ["@types/vscode"]
		},
		"packages/{build,ipc}": {
			"project": ["src/**/*.ts!"]
		}
	},
	"rules": {
		"classMembers": "off"
	}
}
