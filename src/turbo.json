{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"test": {
			"dependsOn": ["$TURBO_EXTENDS$", "bundle"]
		},
		"test:unit": {
			"dependsOn": ["@roo-code/types#build"],
			"inputs": ["$TURBO_DEFAULT$", "!__tests__/dist_assets.spec.ts"]
		},
		"test:dist": {
			"dependsOn": ["bundle"]
		},
		"test:coverage": {
			"dependsOn": ["$TURBO_EXTENDS$", "bundle"]
		},
		"test:coverage:unit": {
			"dependsOn": ["@roo-code/types#build"],
			"inputs": ["$TURBO_DEFAULT$", "!__tests__/dist_assets.spec.ts"],
			"outputs": ["coverage/unit/**"]
		},
		"test:coverage:api": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!core/**/__tests__/**",
				"!services/**/__tests__/**",
				"!__tests__/**",
				"!activate/**/__tests__/**",
				"!extension/**/__tests__/**",
				"!i18n/**/__tests__/**",
				"!integrations/**/__tests__/**",
				"!scripts/**/__tests__/**",
				"!shared/**/__tests__/**",
				"!test-utils/**/__tests__/**",
				"!utils/**/__tests__/**",
				"!core/message-manager/index.spec.ts",
				"!scripts/verify-lcov.spec.mjs"
			],
			"outputs": ["coverage/api/**"]
		},
		"test:coverage:core": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!api/**/__tests__/**",
				"!services/**/__tests__/**",
				"!__tests__/**",
				"!activate/**/__tests__/**",
				"!extension/**/__tests__/**",
				"!i18n/**/__tests__/**",
				"!integrations/**/__tests__/**",
				"!scripts/**/__tests__/**",
				"!shared/**/__tests__/**",
				"!test-utils/**/__tests__/**",
				"!utils/**/__tests__/**",
				"!scripts/verify-lcov.spec.mjs"
			],
			"outputs": ["coverage/core/**"]
		},
		"test:coverage:services": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!api/**/__tests__/**",
				"!core/**/__tests__/**",
				"!services/tree-sitter/**/__tests__/**",
				"!services/__tests__/pr-review-state-workflow.test.ts",
				"!__tests__/**",
				"!activate/**/__tests__/**",
				"!extension/**/__tests__/**",
				"!i18n/**/__tests__/**",
				"!integrations/**/__tests__/**",
				"!scripts/**/__tests__/**",
				"!shared/**/__tests__/**",
				"!test-utils/**/__tests__/**",
				"!utils/**/__tests__/**",
				"!core/message-manager/index.spec.ts",
				"!scripts/verify-lcov.spec.mjs"
			],
			"outputs": ["coverage/services/**"]
		},
		"test:coverage:misc": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!api/**/__tests__/**",
				"!core/**/__tests__/**",
				"!services/**/__tests__/**",
				"!__tests__/dist_assets.spec.ts",
				"!core/message-manager/index.spec.ts"
			],
			"outputs": ["coverage/misc/**"]
		},
		"test:coverage:tree-sitter": {
			"dependsOn": ["@roo-code/types#build"],
			"inputs": [
				"services/tree-sitter/**",
				"services/shared/fallback-extensions.ts",
				"core/ignore/RooIgnoreController.ts",
				"utils/fs.ts",
				"utils/path.ts",
				"utils/vitest-verbosity.ts",
				"__mocks__/**",
				"vitest.setup.ts",
				"vitest.config.ts",
				"vitest.tree-sitter.config.ts",
				"package.json",
				"tsconfig.json"
			],
			"outputs": ["coverage/tree-sitter/**"]
		},
		"test:api": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!core/**/__tests__/**",
				"!services/**/__tests__/**",
				"!__tests__/**",
				"!activate/**/__tests__/**",
				"!extension/**/__tests__/**",
				"!i18n/**/__tests__/**",
				"!integrations/**/__tests__/**",
				"!scripts/**/__tests__/**",
				"!shared/**/__tests__/**",
				"!test-utils/**/__tests__/**",
				"!utils/**/__tests__/**",
				"!core/message-manager/index.spec.ts",
				"!scripts/verify-lcov.spec.mjs"
			]
		},
		"test:core": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!api/**/__tests__/**",
				"!services/**/__tests__/**",
				"!__tests__/**",
				"!activate/**/__tests__/**",
				"!extension/**/__tests__/**",
				"!i18n/**/__tests__/**",
				"!integrations/**/__tests__/**",
				"!scripts/**/__tests__/**",
				"!shared/**/__tests__/**",
				"!test-utils/**/__tests__/**",
				"!utils/**/__tests__/**",
				"!scripts/verify-lcov.spec.mjs"
			]
		},
		"test:services": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!api/**/__tests__/**",
				"!core/**/__tests__/**",
				"!services/tree-sitter/**/__tests__/**",
				"!services/__tests__/pr-review-state-workflow.test.ts",
				"!__tests__/**",
				"!activate/**/__tests__/**",
				"!extension/**/__tests__/**",
				"!i18n/**/__tests__/**",
				"!integrations/**/__tests__/**",
				"!scripts/**/__tests__/**",
				"!shared/**/__tests__/**",
				"!test-utils/**/__tests__/**",
				"!utils/**/__tests__/**",
				"!core/message-manager/index.spec.ts",
				"!scripts/verify-lcov.spec.mjs"
			]
		},
		"test:misc": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!scripts/verify-coverage-cache-inputs.mjs",
				"!scripts/coverage-contract.mjs",
				"!scripts/verify-coverage-contract.mjs",
				"!scripts/verify-lcov.mjs",
				"!api/**/__tests__/**",
				"!core/**/__tests__/**",
				"!services/**/__tests__/**",
				"!__tests__/dist_assets.spec.ts",
				"!core/message-manager/index.spec.ts"
			]
		},
		"test:tree-sitter": {
			"dependsOn": ["@roo-code/types#build"],
			"inputs": [
				"services/tree-sitter/**",
				"services/shared/fallback-extensions.ts",
				"core/ignore/RooIgnoreController.ts",
				"utils/fs.ts",
				"utils/path.ts",
				"utils/vitest-verbosity.ts",
				"__mocks__/**",
				"vitest.setup.ts",
				"vitest.config.ts",
				"vitest.tree-sitter.config.ts",
				"package.json",
				"tsconfig.json"
			]
		},
		"bundle": {
			"dependsOn": ["^build", "@roo-code/vscode-webview#build"],
			"outputs": [
				"dist/**",
				"README.md",
				"CHANGELOG.md",
				"LICENSE",
				"webview-ui/audio/**",
				"assets/vscode-material-icons/**"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/README.md",
				"$TURBO_ROOT$/CHANGELOG.md",
				"$TURBO_ROOT$/LICENSE",
				"$TURBO_ROOT$/.env",
				"$TURBO_ROOT$/webview-ui/audio/**"
			],
			"env": ["PKG_RELEASE_CHANNEL", "POSTHOG_API_KEY"]
		},
		"vsix": {
			"dependsOn": ["bundle"],
			"inputs": ["$TURBO_DEFAULT$", "dist/**", "README.md", "CHANGELOG.md", "LICENSE"],
			"outputs": ["../bin/**"]
		},
		"watch:bundle": {
			"dependsOn": ["@roo-code/build#build", "@roo-code/types#build"],
			"cache": false
		}
	}
}
