{
	"extends": "@roo-code/config-typescript/base.json",
	"compilerOptions": {
		"outDir": "dist",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"incremental": true,
		"tsBuildInfoFile": "node_modules/.cache/tsc/cli.tsbuildinfo"
	},
	"include": ["src", "*.config.ts"],
	"exclude": ["node_modules"]
}
